const express = require('express');
const fs = require('fs');
const path = require('path');
const app = express();
const PORT = 3000;

app.use(express.json({ limit: '50mb' }));
app.use(express.static('.'));

// Helper to read/write local JSON
const readJson = (file) => {
  try { return JSON.parse(fs.readFileSync(file, 'utf8')); } catch { return null; }
};
const writeJson = (file, data) => fs.writeFileSync(file, JSON.stringify(data, null, 2));

// CONFIG API
app.get('/api/config', (req, res) => {
  const config = readJson('config.json') || {
    title: 'Universal Institute Kottakkal',
    welcomeMessage: 'Welcome To Universal',
    ogTitle: 'Universal Institute Kottakkal',
    ogDescription: 'The best coaching institute in Malabar. Visit us today!',
    delay: 2,
    duration: 10,
    logoUrl: '/image.png',
    bannerUrl: 'https://universalinstitute.in/uploadpics/Banner_1744789755.jpg',
    soundUrl: '/screaming_girl.mp3'
  };
  res.json(config);
});

app.post('/api/config', (req, res) => {
  const password = process.env.ADMIN_PASSWORD || 'admin123';
  if (req.body.auth !== password) return res.status(401).json({ error: 'Unauthorized' });
  const config = req.body;
  delete config.auth;
  writeJson('config.json', config);
  res.json({ success: true, config });
});

// UPLOAD API (saves files locally)
app.post('/api/upload', (req, res) => {
  const password = process.env.ADMIN_PASSWORD || 'admin123';
  if (req.body.auth !== password) return res.status(401).json({ error: 'Unauthorized' });

  const { fileType, fileData } = req.body;
  const buffer = Buffer.from(fileData, 'base64');
  let fileName;

  if (fileType === 'logo') fileName = 'image.png';
  else if (fileType === 'banner') fileName = 'banner.jpg';
  else if (fileType === 'sound') fileName = 'screaming_girl.mp3';
  else return res.status(400).json({ error: 'Invalid type' });

  fs.writeFileSync(fileName, buffer);
  res.json({ success: true, url: '/' + fileName });
});

// ANALYTICS API
app.get('/api/analytics', (req, res) => {
  const password = process.env.ADMIN_PASSWORD || 'admin123';
  if (req.query.auth !== password) return res.status(401).json({ error: 'Unauthorized' });
  const data = readJson('analytics.json') || { visits: [], screams: 0 };
  res.json(data);
});

app.post('/api/analytics', (req, res) => {
  const data = readJson('analytics.json') || { visits: [], screams: 0 };
  const entry = {
    timestamp: new Date().toISOString(),
    userAgent: req.body.userAgent || 'Unknown',
    referrer: req.body.referrer || 'Direct',
    triggered: req.body.triggered || false,
    ipHash: 'local-test'
  };
  data.visits.unshift(entry);
  if (entry.triggered) data.screams = (data.screams || 0) + 1;
  if (data.visits.length > 1000) data.visits = data.visits.slice(0, 1000);
  writeJson('analytics.json', data);
  res.json({ success: true });
});

app.listen(PORT, '0.0.0.0', () => {
  console.log(`✅ Temporary server running at http://localhost:${PORT}`);
  console.log(`📱 On your phone (same WiFi): http://<YOUR_IP>:${PORT}`);
  console.log(`🔑 Admin password: admin123 (change in server.js if needed)`);
  console.log(`📝 Press Ctrl+C to stop. Delete config.json & analytics.json to wipe data.`);
});
